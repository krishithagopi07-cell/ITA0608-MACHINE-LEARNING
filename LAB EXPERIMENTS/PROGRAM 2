
import csv
from io import StringIO

csv_data = """Sky,AirTemp,Humidity,Wind,Water,Forecast,EnjoySport
Sunny,Warm,Normal,Strong,Warm,Same,Yes
Sunny,Warm,High,Strong,Warm,Same,Yes
Rainy,Cold,High,Strong,Warm,Change,No
Sunny,Warm,High,Strong,Cool,Change,Yes
"""

data = list(csv.reader(StringIO(csv_data)))
data = data[1:]

S = ['0'] * 6
G = [['?' for _ in range(6)]]

for row in data:
    x = row[:-1]
    label = row[-1]

    if label == 'Yes':
        for i in range(6):
            if S[i] == '0':
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = '?'
    else:
        new_G = []
        for g in G:
            for i in range(6):
                if g[i] == '?' and S[i] != '?' and S[i] != x[i]:
                    h = g.copy()
                    h[i] = S[i]
                    if h not in new_G:
                        new_G.append(h)
        G = new_G

print("Specific Boundary (S):", S)
print("General Boundary (G):", G)
